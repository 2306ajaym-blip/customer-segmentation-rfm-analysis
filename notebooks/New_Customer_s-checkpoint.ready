   ],
   "source": [
    "# Step 10.1: Top 10 Customers by Total Spending\n",
    "top_customers = customer_spending_clean.sort_values('TotalAmount', ascending=False).head(10)\n",
    "plt.figure(figsize=(10,5))\n",
    "plt.bar(top_customers['CustomerID'].astype(str), top_customers['TotalAmount'], color='skyblue')\n",
    "plt.title('Top 10 Customers by Total Spending')\n",
    "plt.xlabel('Customer ID')\n",
    "plt.ylabel('Total Spending')\n",
    "plt.xticks(rotation=45)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "8259deaf-29a1-4317-a8da-be2bc2849ed6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ensure TotalAmount exists\n",
    "df['TotalAmount'] = df['Quantity'] * df['UnitPrice']\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "069c283e-17d7-4d61-9d7c-b3be0b617059",
   "metadata": {},
