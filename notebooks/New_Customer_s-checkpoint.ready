   "source": [
    "# step 1 - Load data\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv('customer_data.csv', encoding='latin1')\n",
    "df.head()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "f60e83a6-ab48-4008-a795-cc42700c425d",
   "metadata": {},
