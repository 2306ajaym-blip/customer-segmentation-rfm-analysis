     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Step 12.2 - Visualize Customer Segments\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "segment_counts = rfm['CustomerSegment'].value_counts()\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "plt.bar(segment_counts.index, segment_counts.values, color='lightcoral', edgecolor='black')\n",
    "plt.title('Customer Segmentation based on RFM Scores')\n",
    "plt.xlabel('Customer Segment')\n",
    "plt.ylabel('Number of Customers')\n",
    "plt.xticks(rotation=30)\n",
    "plt.show()"
   ]
  },
