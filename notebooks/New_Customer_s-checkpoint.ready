   "source": [
    "# Step 2: Quick data exploration\n",
    "print(df.head())\n",
    "print(df.info())\n",
    "print(df.describe())\n",
    "print(\"Missing values:\\n\", df.isnull().sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "5b44c78f-c4a9-4338-9e07-7f1803bab2e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Drop rows with missing CustomerID or Quantity/UnitPrice\n",
    "df = df.dropna(subset=['CustomerID', 'Quantity', 'UnitPrice'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "fa38523b-12ee-460a-a190-044ac2811c72",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Remove duplicates\n",
    "df = df.drop_duplicates()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "2bfa6d4f-a85f-455d-9fe8-0978b11f3553",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Create TotalAmount column\n",
    "df['TotalAmount'] = df['Quantity'] * df['UnitPrice']\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "5d7052a4-78b1-46e8-874e-6284f7ac4e6f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 6: Aggregate total spending per customer\n",
    "customer_spending = df.groupby('CustomerID')['TotalAmount'].sum().reset_index()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "0c3abc16-21c9-49ae-ac0e-882102a7ecae",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Step 7: Plot distribution of customer spending\n",
    "plt.hist(customer_spending['TotalAmount'], bins=20, color='lightblue', edgecolor='black')\n",
    "plt.title('Distribution of Customer Spending')\n",
    "plt.xlabel('Total Spending')\n",
    "plt.ylabel('Number of Customers')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "9ddace57-213a-419e-ae4a-c53b21816109",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 8: Create Spending Score and Segmentation\n",
    "\n",
    "# Step 8.1: Normalize total spending to a score (0–100)\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "scaler = MinMaxScaler(feature_range=(0, 100))\n",
    "customer_spending['SpendingScore'] = scaler.fit_transform(customer_spending[['TotalAmount']])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "b33a20ad-d055-48eb-85fa-48d33232d61c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 8.2: Segment customers\n",
    "# You can use simple rules based on score\n",
    "def segment(score):\n",
    "    if score < 33:\n",
    "        return 'Low'\n",
    "    elif score < 66:\n",
    "        return 'Medium'\n",
    "    else:\n",
    "        return 'High'\n",
    "\n",
    "customer_spending['Segment'] = customer_spending['SpendingScore'].apply(segment)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "a4fefa10-0bc3-4016-bc4e-11cd67731c87",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   CustomerID  TotalAmount  SpendingScore Segment\n",
      "0     12346.0         0.00       1.510917     Low\n",
      "1     12347.0      4310.00       3.029717     Low\n",
      "2     12348.0      1797.24       2.144246     Low\n",
      "3     12349.0      1757.55       2.130260     Low\n",
      "4     12350.0       334.40       1.628756     Low\n"
     ]
    }
   ],
   "source": [
    "# Step 8.3: Check results\n",
    "print(customer_spending.head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "4f6237eb-9e9a-4d25-917b-41f959e3f1dc",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Step 8.4: Visualize segments\n",
    "segment_counts = customer_spending['Segment'].value_counts()\n",
    "plt.bar(segment_counts.index, segment_counts.values, color=['red', 'orange', 'green'])\n",
    "plt.title('Customer Segments Based on Spending')\n",
    "plt.xlabel('Segment')\n",
    "plt.ylabel('Number of Customers')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "e28a127e-0bea-4f29-bcba-3e6abba02a90",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 9: Detect outliers in customer spending\n",
    "Q1 = customer_spending['TotalAmount'].quantile(0.25)\n",
    "Q3 = customer_spending['TotalAmount'].quantile(0.75)\n",
    "IQR = Q3 - Q1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "886af4a7-26e7-46e6-b8e2-5eba8ef34fcf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of outliers: 421\n",
      "    CustomerID  TotalAmount  SpendingScore Segment\n",
      "1      12347.0      4310.00       3.029717     Low\n",
      "10     12357.0      6207.67       3.698437     Low\n",
      "12     12359.0      6182.98       3.689736     Low\n",
      "15     12362.0      5154.58       3.327339     Low\n",
      "27     12378.0      4008.62       2.923514     Low\n"
     ]
    }
   ],
   "source": [
    "# Identify outliers\n",
    "outliers = customer_spending[\n",
    "    (customer_spending['TotalAmount'] < (Q1 - 1.5 * IQR)) |\n",
    "    (customer_spending['TotalAmount'] > (Q3 + 1.5 * IQR))\n",
    "]\n",
    "\n",
    "print(\"Number of outliers:\", outliers.shape[0])\n",
    "print(outliers.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "0865b4ae-ddd4-4b81-9652-a07fc7c82219",
   "metadata": {},
   "outputs": [],
   "source": [
    "# (Optional) Remove outliers for smoother visualization\n",
    "customer_spending_clean = customer_spending[\n",
    "    (customer_spending['TotalAmount'] >= (Q1 - 1.5 * IQR)) &\n",
    "    (customer_spending['TotalAmount'] <= (Q3 + 1.5 * IQR))\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "a10102b6-5c21-4430-9ac9-3f91f8de3471",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "C:\\Users\\ajaym\\AppData\\Local\\Temp\\ipykernel_7704\\373379624.py:3: MatplotlibDeprecationWarning: The 'labels' parameter of boxplot() has been renamed 'tick_labels' since Matplotlib 3.9; support for the old name will be dropped in 3.11.\n",
      "  plt.boxplot([customer_spending_clean['TotalAmount'], outliers['TotalAmount']],\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Visualize clean vs outlier spending\n",
    "plt.figure(figsize=(8,5))\n",
    "plt.boxplot([customer_spending_clean['TotalAmount'], outliers['TotalAmount']],\n",
    "            labels=['Clean Data', 'Outliers'])\n",
    "plt.title('Customer Spending: Clean vs Outlier Comparison')\n",
    "plt.ylabel('Total Spending')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
