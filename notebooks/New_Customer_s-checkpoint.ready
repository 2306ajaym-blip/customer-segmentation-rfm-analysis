    }
   ],
   "source": [
    "# Step 10.2: Top 10 Selling Countries\n",
    "country_sales = df.groupby('Country')['TotalAmount'].sum().sort_values(ascending=False)\n",
    "top_countries = country_sales.head(10)\n",
    "\n",
    "plt.figure(figsize=(10,5))\n",
    "plt.bar(top_countries.index, top_countries.values, color='lightgreen')\n",
    "plt.title('Top 10 Countries by Sales')\n",
    "plt.xlabel('Country')\n",
    "plt.ylabel('Total Sales')\n",
    "plt.xticks(rotation=45)\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "a55c6dbb-0cfb-4b84-803b-543e283c4de7",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'], dayfirst=True, errors='coerce')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3fc7bcc8-262b-4794-a525-6faeab542e0a",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "08b72c03-8bf6-4419-a1b2-26882588898a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# step 10.3 : Sales Trend Over Time\n",
    "df['Month'] = df['InvoiceDate'].dt.to_period('M')\n",
    "monthly_sales = df.groupby('Month')['TotalAmount'].sum().reset_index()\n",
    "\n",
    "plt.figure(figsize=(10,5))\n",
    "plt.plot(monthly_sales['Month'].astype(str), monthly_sales['TotalAmount'], marker='o', color='coral')\n",
    "plt.title('Monthly Sales Trend')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Total Sales')\n",
    "plt.xticks(rotation=45)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9958d856-9338-4ded-81b5-a2519e803048",
   "metadata": {},
   "outputs": [],
   "source": [
    "Step 11: Customer Segmentation (RFM Analysis)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "5a4d84da-5d14-466a-99e2-5082f01ca1ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "import datetime as dt\n",
    "\n",
    "# Find the most recent date in the dataset\n",
    "latest_date = df['InvoiceDate'].max() + pd.Timedelta(days=1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "ad22f85f-1d0c-48c7-aa1a-a4c5544a14e8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RFM Calculation\n",
    "rfm = df.groupby('CustomerID').agg({\n",
    "    'InvoiceDate': lambda x: (latest_date - x.max()).days,  # Recency\n",
    "    'InvoiceNo': 'nunique',                                 # Frequency\n",
    "    'TotalAmount': 'sum'                                    # Monetary\n",
    "}).reset_index()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "07657b77-179f-4aac-87b0-f1cbff3c104e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
       "<div>\n",
       "<style scoped>\n",
       "    .dataframe tbody tr th:only-of-type {\n",
       "        vertical-align: middle;\n",
       "    }\n",
       "\n",
       "    .dataframe tbody tr th {\n",
       "        vertical-align: top;\n",
       "    }\n",
       "\n",
